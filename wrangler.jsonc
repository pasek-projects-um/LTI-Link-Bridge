{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lti-link-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [{"binding":"DB","database_name":"lti-link-bridge","database_id":"REPLACE_WITH_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "vars": {"PUBLIC_BASE_URL":"http://localhost:8787","SESSION_TTL_SECONDS":"14400"}
}
