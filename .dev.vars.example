# Do not use sample values for production. Generate with a cryptographic RNG.
HMAC_KEY_V1=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES_BASE64URL
SESSION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES_BASE64URL
# For an explicit new-course rotation only:
# HMAC_KEY_V2=REPLACE_WITH_AN_INDEPENDENT_RANDOM_BASE64URL_SECRET
# HMAC_ACTIVE_VERSION=v2
# Optional for Deep Linking response; generate RSA keypair and publish public JWK via /lti/jwks.
TOOL_PRIVATE_JWK=REPLACE_WITH_RSA_PRIVATE_JWK_JSON
# Retention of educational records is OFF unless explicitly approved.
# RETENTION_ENABLED=1
# RETENTION_LAUNCH_DAYS=90
# RETENTION_IDENTITY_DAYS=180
# RETENTION_AUDIT_DAYS=365
# Optional Canvas API credentials: provision as a Worker Secret, NOT as a checked-in file.
# CANVAS_API_TOKENS={"deployment-1":"<institution-managed-token>"}
